#!/usr/bin/env python3
"""Grounded Commits reference commit-msg hook.

Checks what is mechanical in the format and nothing else: that the subject
is `area: outcome` with an area taken from the changed paths, that a commit
changing more than documentation carries evidence (`Verified:` or
`Not-verified:`), that the trailer block is one Git can read and each
trailer's value has its parts, and that nothing in the message would act on
a forge (CI control tokens, issue-closing keywords). Whether a reason is true
or a claim is substantiated is judgement no script can see, and the hook
does not try; nor does it police wording or capitalisation.

Install (see tooling/README.md):
  curl -fsSL -o .git/hooks/commit-msg <raw URL of this file> && chmod +x .git/hooks/commit-msg

Usage:
  commit-msg <message-file>          Git hook mode: check the message being
                                     committed against the staged paths
  commit-msg --rev <rev>             check an existing commit
  commit-msg --range <base>..<head>  check every commit in a range (CI, landing)
  commit-msg --areas [--rev <rev>]   print the areas the staged change, or
                                     <rev>, could use
  commit-msg --message-file F        check a draft message against the staged
                                     change, a merge in progress included,
                                     before `git commit -F F` records it
  commit-msg --message-file F --rev <rev>
                                     check a draft message against an existing
                                     commit's changes without committing it
                                     (before an amend or a rebase reword)
  commit-msg --message-file F --paths a/b.c d/e.f
                                     check a message against given paths

Exit 0 when clean, 1 with findings (one per line on stderr), 2 on error.

Hook mode sees the staged changes, so `git commit --amend` with new changes
staged is checked against those changes only; run `--rev HEAD` after an
amend. A merge is checked against the paths where it departs from Git's own
merge of its parents, the conflicts resolved by hand and any edit made on
top, which needs Git 2.38 or newer; a clean merge passes with Git's own
message. Hook mode checks the message as Git's editor cleanup leaves it,
comment lines dropped; a `#` line kept by `git commit -m` or `-F` is only
seen by `--rev` afterwards.

Optional configuration in <repo>/.grounded-commits.toml (Python 3.11+):
  forge = "github" | "gitlab" | "forgejo" | "any"     # default "any"
  header = "area" | "typed"                            # default "area"
  breaking_marker = "trailer" | "paragraph"            # typed profile only; default "trailer"
  areas = ["cli", "config"]                            # areas that are always valid
  contract_docs = ["docs/api/", "openapi.yaml"]        # documentation that needs evidence
  issue_keys = ["PROJ", "OPS"]                         # tracker keys: PROJ-42 is then an issue
  [area_map]                                           # path prefix -> area
  ".github/" = "ci"
  "myproject/billing/" = "billing"
"""

import argparse
import os
import re
import subprocess
import sys
import unicodedata
from pathlib import PurePosixPath
from urllib.parse import urlsplit

FORMAT_VERSION = "0.5.0"
# The guidance asks for about 72 columns; the hook stops only what no display
# shows whole.
LINE_LIMIT = 80
SUBJECT_SCAN_LIMIT = 400  # beyond this a subject is only reported as too long
SUBJECT_RE = re.compile(r"^([^:\s]+): (\S.*)$")
TYPED_SUBJECT_RE = re.compile(r"^(feat|fix|perf|refactor|docs|test|build|ci)\(([^)]*)\)(!?): (\S.*)$")
# Words that say what kind of change a commit is. Never areas, which say where
# a change lives.
TYPE_WORDS = {"feat", "fix", "perf", "chore", "refactor", "style", "revert"}
# Areas valid in every repository: the usual homes of a change that no single
# directory names.
BUILT_IN_AREAS = {"all", "docs", "ci", "build", "test", "tests", "deps"}

REVERT_RE = re.compile(r'^(Revert|Reapply) ".+"$')
# The conflict list Git appends to a merge or cherry-pick message as comment
# lines, which a commit made without the editor keeps.
CONFLICT_LIST_RE = re.compile(r"^(\S) Conflicts:\n(?:\1\n)?(?:\1\t.*\n?)+", re.MULTILINE)
AUTOSQUASH_PREFIXES = ("fixup! ", "squash! ", "amend! ")
# Paths whose change claims nothing about behaviour, so owes no evidence:
# documentation, and files that only steer tools around the code.
DOC_SUFFIXES = {".md", ".markdown", ".rst", ".adoc", ".org"}
DOC_NAMES = {"license", "licence", "copying", "authors", "contributors", "notice", "changelog", "readme",
             "codeowners", ".gitattributes", ".editorconfig", ".mailmap"}

OWN_KEYS = ("Verified", "Not-verified", "Refs", "Introduced-by", "Breaking-Change")
RENAMED_KEYS = {"fixes": "Introduced-by"}
KNOWN_TRAILER_KEYS = ("verified", "not-verified", "refs", "introduced-by", "fixes", "breaking-change", "co-authored-by",
                      "signed-off-by", "reviewed-by", "reviewed-on", "tested-by", "acked-by", "reported-by",
                      "suggested-by", "assisted-by", "change-id", "link")
TRAILER_LIKE_RE = re.compile(r"^(" + "|".join(KNOWN_TRAILER_KEYS) + r")\s*:", re.IGNORECASE)
TRAILER_LINE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9-]*: \S")
FILLER = {"passed", "pass", "ok", "okay", "n/a", "na", "none", "tests pass", "tests passed",
          "success", "succeeded", "done", "fine", "-", "yes", "all good", "works"}
INTRODUCED_BY_RE = re.compile(r'^(?P<hash>[0-9a-fA-F]{12,64}) \("(?P<subject>.+)"\)$')
HONEST_ROUTE = ("; if you have no such evidence, write `Not-verified: <what was not checked>; <why>` "
                "instead, and never supply an outcome from memory")

CI_TOKEN_RE = re.compile(
    r"\[(skip[ _-]ci|ci[ _-]skip|no[ _-]ci|skip[ _-]actions|actions[ _-]skip|skip[ _-]azurepipelines"
    r"|azurepipelines[ _-]skip|skip[ _-]azp|azp[ _-]skip)\]|skip-checks:|\*\*\*no_ci\*\*\*", re.IGNORECASE)
# Closing and reopening keywords, each directly before a reference the forge
# resolves. "any" is the union of the three forges' defaults.
KEYWORDS = {
    "github": r"close[sd]?|fix(e[sd])?|resolve[sd]?",
    "gitlab": r"close[sd]?|closing|fix(e[sd])?|fixing|resolve[sd]?|resolving|implement(s|ed|ing)?",
    "forgejo": r"close[sd]?|fix(e[sd])?|resolve[sd]?|reopen(s|ed)?",
}
KEYWORDS["any"] = "|".join(KEYWORDS.values())
REFERENCES = {
    "github": r"#\d+|[\w.-]+/[\w.-]+#\d+",
    "gitlab": r"#\d+|[\w.-]+(/[\w.-]+)+#\d+|https?://\S+/-/(issues|work_items)/\d+",
    "forgejo": r"#\d+|[\w.-]+/[\w.-]+#\d+|https?://\S+/issues/\d+",
}
REFERENCES["any"] = r"#\d+|[\w.-]+(/[\w.-]+)+#\d+|https?://\S+/(issues|-/issues|work_items)/\d+"
# A tracker key such as PROJ-42 counts as a reference only where the repository
# names its keys in `issue_keys`: the shape alone also fits UTF-8, SHA-256 and
# AGPL-3.0, so an unnamed key is taken to be an identifier.
ISSUE_KEY_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")


def issue_key_pattern(config):
    """`(PROJ|OPS)-<digits>` for the configured tracker keys, or None without any."""
    keys = config["issue_keys"]
    return "(" + "|".join(re.escape(key) for key in keys) + r")-\d+" if keys else None


def reference_pattern(config):
    """A group matching what the configured forge resolves as an issue reference."""
    keys = issue_key_pattern(config)
    return "(" + REFERENCES[config["forge"]] + (f"|{keys}" if keys else "") + ")"


class CheckError(Exception):
    pass


# --- git -------------------------------------------------------------------

def git(*args, repo=None, stdin=None, check=True):
    cmd = ["git"] + (["-C", repo] if repo else []) + list(args)
    result = subprocess.run(cmd, input=stdin, capture_output=True, text=True, errors="surrogateescape")
    if check and result.returncode != 0:
        raise CheckError(result.stderr.strip() or f"git {' '.join(args)} failed")
    return result.stdout


def repo_root(repo=None):
    try:
        return git("rev-parse", "--show-toplevel", repo=repo).strip()
    except CheckError:
        return None


def git_path(repo, name):
    """A path inside the Git directory, absolute whatever the working directory."""
    path = git("rev-parse", "--git-path", name, repo=repo).strip()
    return path if os.path.isabs(path) else os.path.join(repo or os.getcwd(), path)


def parents_of(repo, rev):
    return git("rev-list", "--parents", "-n", "1", rev, repo=repo).split()[1:]


def has_head(repo):
    return bool(git("rev-parse", "--verify", "--quiet", "HEAD", repo=repo, check=False).strip())


# Rename detection and whitespace-insensitive comparison, under which a change
# that is only renames and whitespace shows no line added or removed.
INERT_DIFF_OPTIONS = ("-M", "--ignore-space-at-eol", "--ignore-cr-at-eol", "--ignore-blank-lines", "--numstat")


def inert_change(repo, rev=None):
    """True when the change is only renames and whitespace, which claims
    nothing about behaviour and so owes no evidence. `rev` is a recorded
    commit; without it, the staged change."""
    if rev:
        out = git("diff-tree", "--no-commit-id", "-r", "--root", *INERT_DIFF_OPTIONS, rev, repo=repo)
    else:
        out = git("diff", "--cached", *INERT_DIFF_OPTIONS, repo=repo)
    return all(line.split("\t")[:2] == ["0", "0"] for line in out.splitlines() if line)


def staged_paths(repo, message):
    """(paths, merge, inert, amend) for the commit being made. A merge in
    progress is checked against its resolutions (see `resolution_paths`).
    With nothing staged, a message whose subject is HEAD's is taken to be a
    message-only amend and uses HEAD's paths; otherwise (an empty commit)
    there are no paths."""
    merge_head = git_path(repo, "MERGE_HEAD")
    if os.path.exists(merge_head):
        with open(merge_head, encoding="utf-8") as handle:
            parents = ["HEAD"] + handle.read().split()
        return resolution_paths(repo, parents), True, False, False
    paths = [p for p in git("diff", "--cached", "--name-only", "-z", repo=repo).split("\0") if p]
    if not paths and has_head(repo):
        head_subject = git("show", "-s", "--format=%s", "HEAD", repo=repo).strip()
        if message.split("\n", 1)[0].strip() == head_subject:
            return commit_paths(repo, "HEAD"), False, inert_change(repo, "HEAD"), True
    return paths, False, bool(paths) and inert_change(repo), False


def commit_paths(repo, rev):
    return [p for p in git("diff-tree", "--no-commit-id", "--name-only", "-r", "--root", "-z", rev, repo=repo).split("\0")
            if p]


def merged_tree(repo, ours, theirs):
    """The tree Git's own merge of two commits produces, conflict markers and all."""
    result = subprocess.run(["git", "-C", repo, "merge-tree", "--write-tree", "--no-messages", ours, theirs],
                            capture_output=True, text=True, errors="surrogateescape")
    if result.returncode not in (0, 1):  # 1 means the merge has conflicts
        raise CheckError("git merge-tree --write-tree failed (checking a merge needs Git 2.38 or newer): "
                         + result.stderr.strip())
    return result.stdout.split("\n", 1)[0].strip()


def resolution_paths(repo, parents, rev=None):
    """The paths where a merge of `parents` departs from Git's own merge of
    them: the conflicts resolved by hand and any edit made on top. A clean
    merge of a file both sides changed is not among them. `rev` is the merge
    commit; without it, the staged merge. An octopus merge falls back to the
    paths that differ from every parent."""
    bases = [merged_tree(repo, *parents)] if len(parents) == 2 else parents
    found = None
    for base in bases:
        args = ["diff-tree", "-r", "--name-only", "-z", base, rev] if rev else \
            ["diff-index", "--cached", "--name-only", "-z", base]
        paths = set(git(*args, repo=repo).split("\0")) - {""}
        found = paths if found is None else found & paths
    return sorted(found)


def is_ancestor(repo, commit, anchor):
    return subprocess.run(["git", "-C", repo, "merge-base", "--is-ancestor", commit, anchor],
                          capture_output=True).returncode == 0


def parse_trailers(message):
    out = git("interpret-trailers", "--parse", "--no-divider", stdin=message)
    pairs = []
    for line in out.splitlines():
        key, _, value = line.partition(":")
        pairs.append((key.strip(), value.strip()))
    return pairs


# --- configuration -----------------------------------------------------------

DEFAULT_CONFIG = {"forge": "any", "header": "area", "breaking_marker": "trailer", "areas": [], "contract_docs": [],
                  "issue_keys": [], "area_map": {}}


def load_config(root):
    path = os.path.join(root, ".grounded-commits.toml") if root else None
    config = {k: (list(v) if isinstance(v, list) else dict(v) if isinstance(v, dict) else v)
              for k, v in DEFAULT_CONFIG.items()}
    if not path or not os.path.exists(path):
        return config
    try:
        import tomllib
    except ImportError as error:  # Python < 3.11
        raise CheckError(f"{path} exists but this Python cannot read TOML; use Python 3.11 or newer") from error
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise CheckError(f"{path}: {error}") from error
    for key, value in data.items():
        if key not in config:
            raise CheckError(f"{path}: unknown key `{key}`")
        config[key] = value
    choices = {"forge": tuple(KEYWORDS), "header": ("area", "typed"), "breaking_marker": ("trailer", "paragraph")}
    for key, allowed in choices.items():
        if not isinstance(config[key], str) or config[key] not in allowed:
            raise CheckError(f"{path}: {key} must be one of {', '.join(allowed)}")
    for key in ("areas", "contract_docs", "issue_keys"):
        if not isinstance(config[key], list) or not all(isinstance(v, str) for v in config[key]):
            raise CheckError(f"{path}: {key} must be a list of strings")
    for key in config["issue_keys"]:
        if not ISSUE_KEY_RE.match(key):
            raise CheckError(f"{path}: issue key `{key}` must be upper-case letters, digits or `_`, starting with a letter")
    if not isinstance(config["area_map"], dict) or not all(
            isinstance(k, str) and isinstance(v, str) for k, v in config["area_map"].items()):
        raise CheckError(f"{path}: area_map must map path prefixes to areas")
    for label in list(config["areas"]) + list(config["area_map"].values()):
        if not normalise(label) or normalise(label) in TYPE_WORDS:
            raise CheckError(f"{path}: `{label}` is not a valid area")
    return config


# --- areas -------------------------------------------------------------------

def normalise(name):
    """Lower case, characters outside [a-z0-9._/-] dropped, and anything that
    is not a letter or digit trimmed from both ends (`.github` gives `github`)."""
    name = re.sub(r"[^a-z0-9._/-]", "", name.lower())
    return re.sub(r"^[^a-z0-9]+|[^a-z0-9]+$", "", name)


def area_candidates(paths, config):
    """The areas the changed paths offer, in path order: every directory on
    a path and the file's name without its extension (with it, where the
    bare name is a change-type word, as for `fix.py`), plus the path map's
    label for any path it covers. Never a change-type word."""
    found = []
    for path in paths:
        parts = path.split("/")
        stem = PurePosixPath(parts[-1]).stem or parts[-1]
        names = parts[:-1] + [stem] + ([parts[-1]] if normalise(stem) in TYPE_WORDS else [])
        matches = [(len(prefix), label) for prefix, label in config["area_map"].items() if path.startswith(prefix)]
        if matches:
            names.insert(0, max(matches)[1])
        for name in names:
            candidate = normalise(name)
            if candidate and candidate not in TYPE_WORDS and candidate not in found:
                found.append(candidate)
    return found


# --- checks ------------------------------------------------------------------

def is_documentation(path, config):
    """Documentation, and files that steer tools around the code without
    being run: a change to them claims nothing about behaviour. A path under
    `contract_docs` states a contract and is not among them."""
    if any(path.startswith(prefix) for prefix in config["contract_docs"]):
        return False
    name = PurePosixPath(path).name.lower()
    return PurePosixPath(path).suffix.lower() in DOC_SUFFIXES or name in DOC_NAMES or name.endswith("ignore")


def paragraphs(lines):
    groups, current, start = [], [], None
    for index, line in enumerate(lines[1:], start=1):
        if line.strip():
            if not current:
                start = index
            current.append(line)
        elif current:
            groups.append((start, current))
            current = []
    if current:
        groups.append((start, current))
    return groups


def split_verified(value):
    first, last = value.find(";"), value.rfind(";")
    if first == -1 or first == last:
        return None
    parts = [value[:first].strip(), value[first + 1:last].strip(), value[last + 1:].strip()]
    return parts if all(parts) else None


def is_filler(text):
    return text.strip().rstrip(".!").strip().lower() in FILLER


def check_subject(subject, paths, config):
    """(findings, bang) for the subject line."""
    findings = []
    subject = subject.rstrip()
    if len(subject) > LINE_LIMIT:
        findings.append(f"subject is {len(subject)} characters; keep it under {LINE_LIMIT}, ideally 72")
        if len(subject) > SUBJECT_SCAN_LIMIT:
            return findings, ""
    bang = ""
    if config["header"] == "typed":
        match = TYPED_SUBJECT_RE.match(subject)
        if not match:
            return findings + ["subject must be `type(area): outcome` with one of feat, fix, perf, refactor, docs, "
                               "test, build, ci, under this repository's typed header profile"], ""
        _, area, bang, outcome = match.groups()
    else:
        match = SUBJECT_RE.match(subject)
        if not match:
            return findings + ["subject must be `<area>: <outcome>`"], ""
        area, outcome = match.groups()
    candidates = area_candidates(paths, config)
    allowed = candidates + sorted((set(config["areas"]) | BUILT_IN_AREAS) - set(candidates))
    allowed_text = ", ".join(f"`{a}`" for a in allowed)
    written = normalise(area)
    if written in TYPE_WORDS or re.split(r"[(!]", area)[0].lower() in TYPE_WORDS:
        findings.append(f"`{area}` says what kind of change this is, not where it lives; this repository uses "
                        f"`area: outcome`, and the changed paths offer {allowed_text}")
    elif paths and written not in allowed:
        findings.append(f"area `{area}` is not a directory or file name from the changed paths; use one of "
                        f"{allowed_text}, or list it in .grounded-commits.toml")
    return findings, bang


def check_body(lines, groups, trailer_block):
    findings = []
    for index, line in enumerate(lines[1:], start=2):
        longest = max((len(token) for token in line.split()), default=0)
        # One unbreakable token (a URL, a path) may overrun; the words around it still wrap.
        if len(line) > LINE_LIMIT and not (longest > 50 and len(line) - longest <= LINE_LIMIT):
            findings.append(f"line {index} is {len(line)} columns; wrap the body at about 72")
    malformed = bool(groups) and not trailer_block and any(TRAILER_LIKE_RE.match(l) for l in groups[-1][1])
    if malformed:
        findings.append("the last paragraph mixes trailers with other lines, so Git does not read it as a "
                        "trailer block; every line there must be `Key: value` or an indented continuation")
    if trailer_block:
        for offset, line in enumerate(groups[-1][1]):
            if not (TRAILER_LINE_RE.match(line) or line.startswith((" ", "\t"))
                    or line.startswith("(cherry picked from commit ")):
                findings.append(f"line {groups[-1][0] + offset + 1} sits in the trailer block but is neither "
                                "`Key: value` nor an indented continuation")
    body_groups = groups[:-1] if (trailer_block or malformed) else groups
    for start, group in body_groups:
        for offset, line in enumerate(group):
            if TRAILER_LIKE_RE.match(line):
                key = line.split(":", 1)[0]
                findings.append(f"`{key}:` on line {start + offset + 1} is outside the final trailer block, so Git "
                                "does not read it; keep every trailer in one last paragraph with no blank line inside")
    return findings


def check_trailer_values(trailers, repo, bang, config, anchors=(), native=False):
    findings = []
    has_break = False
    for key, value in trailers:
        lower = key.lower()
        if lower in RENAMED_KEYS:
            findings.append(f"`{key}:` is `{RENAMED_KEYS[lower]}:` in this format; it names the commit that "
                            "introduced the defect, never an issue")
            continue
        canonical = next((k for k in OWN_KEYS if k.lower() == lower), None)
        if canonical is None:
            continue
        if canonical == "Verified":
            parts = split_verified(value)
            if parts is None:
                findings.append(f"`Verified: {value}` needs three parts: `<what was tested>; <command or scenario>; "
                                "<what you saw>`" + HONEST_ROUTE)
            elif any(is_filler(part) for part in parts):
                findings.append(f"`Verified: {value}` uses a filler word; name what was tested, the command "
                                "and what you saw" + HONEST_ROUTE)
        elif canonical == "Not-verified":
            scope, _, reason = value.partition(";")
            if not scope.strip() or not reason.strip() or is_filler(scope) or is_filler(reason):
                findings.append(f"`Not-verified: {value}` needs `<what was not checked>; <why>`")
        elif canonical == "Refs":
            url = urlsplit(value)
            if url.scheme.lower() not in ("http", "https") or not url.netloc or " " in value:
                findings.append(f"`Refs: {value}` must be one absolute http(s) URL")
        elif canonical == "Introduced-by":
            findings.extend(check_introduced_by(value, repo, anchors))
        elif canonical == "Breaking-Change":
            has_break = True
            what, _, action = value.partition(";")
            if not what.strip() or not action.strip():
                findings.append(f"`Breaking-Change: {value}` needs `<what breaks>; <what the consumer must do>`")
    if config["header"] == "typed" and not native:
        if config["breaking_marker"] == "paragraph":
            if bang:
                findings.append("this repository's release parser reads the spaced `BREAKING CHANGE:` paragraph, "
                                "not `!`; drop the `!` and put the paragraph last in the body")
        elif bool(bang) != has_break:
            findings.append("under the typed header profile `!` before the colon and a `Breaking-Change:` trailer go together")
    return findings


def check_breaking_paragraph(groups, trailers, trailer_block, config):
    """Under the paragraph marker, a break is declared twice: the trailer for
    this format's readers and a `BREAKING CHANGE:` paragraph, last in the
    body and not empty, for the release parser. Each without the other is a
    finding."""
    if config["header"] != "typed" or config["breaking_marker"] != "paragraph":
        return []
    has_trailer = any(key.lower() == "breaking-change" for key, _ in trailers)
    body_groups = groups[:-1] if trailer_block else groups
    marked = [i for i, (_, group) in enumerate(body_groups) if group[0].startswith("BREAKING CHANGE:")]
    if not marked:
        if has_trailer:
            return ["this repository's release parser reads a `BREAKING CHANGE:` paragraph, which is missing; write "
                    "it last in the body, outside the trailer block, beside the `Breaking-Change:` trailer"]
        return []
    findings = []
    if not has_trailer:
        findings.append("a `BREAKING CHANGE:` paragraph without the `Breaking-Change:` trailer; add the trailer, "
                        "which this format's readers extract")
    if marked[-1] != len(body_groups) - 1:
        findings.append("the `BREAKING CHANGE:` paragraph must be the last paragraph of the body, directly before "
                        "the trailer block")
    text = " ".join(body_groups[marked[-1]][1])[len("BREAKING CHANGE:"):].strip()
    if not text:
        findings.append("the `BREAKING CHANGE:` paragraph is empty; say what breaks and what the consumer must do")
    return findings


def check_introduced_by(value, repo, anchors=()):
    """The named commit exists, has the quoted subject, and is an ancestor of
    the commit that names it (`anchors`: that commit, or the parents of one
    being made), so that it stays reachable wherever this commit goes."""
    match = INTRODUCED_BY_RE.match(value)
    if not match:
        return [f'`Introduced-by: {value}` must be `<12-64 hex> ("<subject of the introducing commit>")`; '
                "an issue goes in `Refs:`"]
    if not repo:
        return []
    cited = match["hash"]
    actual = git("show", "-s", "--format=%s", f"{cited}^{{commit}}", repo=repo, check=False).strip()
    if not actual:
        return [f"`Introduced-by:` names {cited}, which is not a commit in this repository"]
    if actual != match["subject"]:
        return [f'`Introduced-by:` quotes "{match["subject"]}" but {cited} has the subject "{actual}"']
    if anchors and not any(is_ancestor(repo, cited, anchor) for anchor in anchors):
        return [f"`Introduced-by:` names {cited}, which is not an ancestor of this commit, so nothing keeps it "
                "reachable from here; name only a commit this one descends from"]
    return []


def forbidden_content(message, config):
    """CI tokens and actionable issue references, anywhere in the text."""
    findings = []
    for match in CI_TOKEN_RE.finditer(message):
        findings.append(f"contains the CI control token `{match.group(0)}`; remove it, and if one is wanted the user adds it")
    actionable = re.compile(r"(?i:\b(" + KEYWORDS[config["forge"]] + r")):?[ \t]+(?i:issues?[ \t]+)?" + reference_pattern(config))
    for match in actionable.finditer(message):
        findings.append(f"`{match.group(0)}` would act on an issue at the forge; reference it as `Refs: <absolute URL>` instead")
    return findings


def check_message(message, paths, config, repo=None, merge=False, inert=False, anchors=()):
    """All findings for one message. For a merge, `paths` are the conflicts
    it resolved by hand and any edit made on top; a clean merge has none.
    `inert` says the change is only renames and whitespace, which claims
    nothing about behaviour. `anchors` are the commits an `Introduced-by:`
    hash must descend from: the parents of the commit, recorded or about to
    be made."""
    findings = forbidden_content(message, config)
    # Blanked rather than cut, so later findings keep the message's line numbers.
    kept_list = CONFLICT_LIST_RE.search(message)
    if kept_list:
        findings.append("Git's conflict list is still in the message; delete it, and say in the body how each "
                        "conflict was resolved")
        message = CONFLICT_LIST_RE.sub(lambda m: "\n" * m.group(0).count("\n"), message)
    lines = message.rstrip("\n").split("\n")
    subject = lines[0].rstrip()
    if subject.startswith(AUTOSQUASH_PREFIXES):
        return findings
    if len(lines) > 1 and lines[1].strip():
        findings.append("the second line must be blank")
    bang = ""
    native = merge or bool(REVERT_RE.match(subject))
    if not native:
        subject_findings, bang = check_subject(subject, paths, config)
        findings.extend(subject_findings)
    groups = paragraphs(lines)
    trailers = parse_trailers(message)
    trailer_block = bool(trailers)
    findings.extend(check_body(lines, groups, trailer_block))
    findings.extend(check_trailer_values(trailers, repo, bang, config, anchors, native))
    findings.extend(check_breaking_paragraph(groups, trailers, trailer_block, config))
    has_evidence = any(key.lower() in ("verified", "not-verified") for key, _ in trailers)
    needing = [] if inert else [p for p in paths if not is_documentation(p, config)]
    if needing and not has_evidence:
        findings.append("no `Verified:` or `Not-verified:` trailer, but the "
                        + ("merge resolves " if merge else "commit changes ") + needing[0]
                        + (f" and {len(needing) - 1} more" if len(needing) > 1 else "")
                        + " beyond plain documentation; `Verified:` records a check you ran and what you saw, and "
                        "`Not-verified: <what was not checked>; <why>` covers what you did not")
    return findings


# --- entry points ------------------------------------------------------------

def rev_paths(repo, rev):
    """(sha, paths, merge, inert) for an existing commit; a merge's paths are
    its resolutions (see `resolution_paths`)."""
    sha = git("rev-parse", "--verify", f"{rev}^{{commit}}", repo=repo).strip()
    parents = parents_of(repo, sha)
    if len(parents) > 1:
        return sha, resolution_paths(repo, parents, sha), True, False
    paths = commit_paths(repo, sha)
    return sha, paths, False, bool(paths) and inert_change(repo, sha)


def staged_anchors(repo, merge, amend=False):
    """The commits a hash cited by the commit being made must descend from:
    its parents, which for a message-only amend are HEAD's parents."""
    if not has_head(repo):
        return []
    if amend:
        return parents_of(repo, "HEAD")
    return ["HEAD", "MERGE_HEAD"] if merge else ["HEAD"]


def check_against_rev(repo, rev, message, config):
    """Findings for `message` as the message of the commit at `rev`, or of
    the commit that replaces it, which has the same parents."""
    sha, paths, merge, inert = rev_paths(repo, rev)
    return sha, check_message(message, paths, config, repo, merge, inert, parents_of(repo, sha))


def check_rev(repo, rev, config):
    message = git("show", "-s", "--format=%B", f"{rev}^{{commit}}", repo=repo)
    sha, findings = check_against_rev(repo, rev, message, config)
    return sha, message, findings


def strip_comments(text, comment_char):
    """The message as Git's comment-stripping cleanup leaves it: comment lines
    and everything from a scissors line dropped."""
    kept = []
    scissors = f"{comment_char} ------------------------ >8 ------------------------"
    for line in text.split("\n"):
        if line.startswith(scissors):
            break
        if not line.startswith(comment_char):
            kept.append(line)
    return "\n".join(kept).strip("\n") + "\n"


def clean(text):
    return "".join(ch if ch in "\n\t" or unicodedata.category(ch)[0] != "C" else "?" for ch in text)


def report(label, message, findings):
    print(clean(f"grounded-commits: {label} ({message.split(chr(10), 1)[0]}):"), file=sys.stderr)
    for finding in findings:
        print(clean(f"- {finding}"), file=sys.stderr)


def main(argv=None):
    parser = argparse.ArgumentParser(description=f"Grounded Commits {FORMAT_VERSION} commit-msg hook")
    parser.add_argument("message_file", nargs="?", help="message file (Git hook mode)")
    parser.add_argument("--rev", help="check an existing commit, or a --message-file draft against its changes")
    parser.add_argument("--range", dest="rev_range", help="check every commit in <base>..<head>")
    parser.add_argument("--areas", action="store_true", help="print the areas the change could use and exit")
    parser.add_argument("--message-file", dest="explicit_file",
                        help="message to check against the staged change, --rev or --paths")
    parser.add_argument("--paths", nargs="*", default=None, help="changed paths for --message-file")
    parser.add_argument("--repo", default=None, help="repository directory (default: current)")
    args = parser.parse_args(argv)
    try:
        root = repo_root(args.repo)
        config = load_config(root)
        if args.explicit_file:
            with open(args.explicit_file, encoding="utf-8", errors="replace") as handle:
                message = handle.read()
            if args.rev:
                if args.paths is not None:
                    raise CheckError("--rev supplies the paths; it cannot be combined with --paths")
                if not root:
                    raise CheckError("not inside a git repository")
                sha, findings = check_against_rev(root, args.rev, message, config)
                label = f"message for {sha[:12]}"
            elif args.paths is not None:
                findings = check_message(message, args.paths, config)
                label = "message"
            else:
                if not root:
                    raise CheckError("not inside a git repository; give --paths to check a message against named paths")
                # Checked as recorded by `git commit -F`, which keeps comment
                # lines, so nothing is stripped here.
                paths, merge, inert, amend = staged_paths(root, message)
                findings = check_message(message, paths, config, root, merge, inert, staged_anchors(root, merge, amend))
                label = "draft message"
        elif args.areas:
            if not root:
                raise CheckError("not inside a git repository")
            paths = rev_paths(root, args.rev)[1] if args.rev else staged_paths(root, "")[0]
            for area in area_candidates(paths, config) or ["all"]:
                print(area)
            return 0
        elif args.rev_range:
            if not root:
                raise CheckError("not inside a git repository")
            shas = git("rev-list", "--reverse", args.rev_range, repo=root).split()
            failed = 0
            for sha in shas:
                sha, message, findings = check_rev(root, sha, config)
                if message.split("\n", 1)[0].startswith(AUTOSQUASH_PREFIXES):
                    findings = findings + ["an autosquash commit (fixup!, squash! or amend!) is in the range; "
                                           "fold it before the branch lands"]
                if findings:
                    failed += 1
                    report(sha[:12], message, findings)
            print(f"grounded-commits: {len(shas) - failed} of {len(shas)} commits clean", file=sys.stderr)
            return 1 if failed else 0
        elif args.rev:
            if not root:
                raise CheckError("not inside a git repository")
            sha, message, findings = check_rev(root, args.rev, config)
            label = sha[:12]
        elif args.message_file:
            if not root:
                raise CheckError("not inside a git repository")
            with open(args.message_file, encoding="utf-8", errors="replace") as handle:
                raw = handle.read()
            comment_char = git("config", "--get", "core.commentChar", repo=root, check=False).strip() or "#"
            if comment_char == "auto":
                comment_char = "#"
            # Prohibited content is checked on the raw text: whether Git keeps
            # comment lines depends on its cleanup mode, so none may carry it.
            findings = forbidden_content(raw, config)
            message = strip_comments(raw, comment_char)
            if not message.strip():
                if raw.strip():
                    findings.append("the message has only comment lines, which Git may keep; write a message")
                else:
                    return 0  # Git aborts an empty message itself
            else:
                paths, merge, inert, amend = staged_paths(root, message)
                findings += [f for f in check_message(message, paths, config, root, merge, inert,
                                                      staged_anchors(root, merge, amend))
                             if f not in findings]
            label = "commit message"
        else:
            parser.print_usage(sys.stderr)
            return 2
    except CheckError as error:
        print(clean(f"grounded-commits: {error}"), file=sys.stderr)
        return 2
    except OSError as error:
        print(clean(f"grounded-commits: {error}"), file=sys.stderr)
        return 2
    if not findings:
        return 0
    report(label, message, findings)
    print("See guidance/commit-messages.md. `Not-verified: <what>; <why>` is always an honest option.", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
